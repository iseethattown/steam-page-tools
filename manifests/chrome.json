{
  "manifest_version": 3,
  "name": "Steam Page Tools",
  "version": "1.3.1",
  "description": "Unofficial Steam profile, badge, friends, inventory valuation, and bulk Store tools.",
  "homepage_url": "https://github.com/ju6697/steam-page-tools",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Steam Page Tools settings",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/my/friends*",
        "https://steamcommunity.com/my/inventory*",
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*",
        "https://store.steampowered.com/search*"
      ],
      "js": [
        "src/settings.js",
        "src/settings-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://steamcommunity.com/my/friends*",
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*",
        "https://store.steampowered.com/search*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://steamcommunity.com/my/inventory*",
        "https://steamcommunity.com/id/*/inventory*",
        "https://steamcommunity.com/profiles/*/inventory*"
      ],
      "js": [
        "src/settings.js",
        "src/features/steam-inventory/inventory.bundle.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
